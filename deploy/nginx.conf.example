# /etc/nginx/sites-available/pregnancy-calendar
# Replace calendar.example.com with your domain, then:
#   sudo ln -s /etc/nginx/sites-available/pregnancy-calendar /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d calendar.example.com     # adds HTTPS automatically

server {
    listen 80;
    server_name calendar.example.com;

    location / {
        proxy_pass http://127.0.0.1:4010;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 25m;
        proxy_read_timeout   120s;   # PDF generation can take a few seconds
    }
}
