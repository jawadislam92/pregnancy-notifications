# Copy to .env and edit, then run:  node --env-file=.env server.js
# (pm2 loads it too via the included ecosystem.config.js)

PORT=4010

# Login gate (HTTP Basic). Leave STUDIO_PASSWORD empty to DISABLE auth.
# STRONGLY recommended to set a strong password before exposing to the internet,
# since the Studio stores customer names/emails.
STUDIO_USER=admin
STUDIO_PASSWORD=change-this-to-a-strong-password
